{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "ConnectionStrings": {
    "MedicalBookingSystem": "Data Source=data/medical.db"
  },
  "Clinic": {
    "TimeZone": "Europe/Warsaw"
  },
  "Database": {
