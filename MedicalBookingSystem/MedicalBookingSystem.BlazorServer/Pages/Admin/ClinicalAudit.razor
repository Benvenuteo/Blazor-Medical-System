@page "/admin/clinical-audit"
@attribute [Authorize(Roles = Roles.Admin)]
@inherits MedicalBookingSystem.BlazorServer.Shared.InteractivePageBase
@using MedicalBookingSystem.SharedKernel
@using MedicalBookingSystem.SharedKernel.Dto
@inject WorklistService Lists

<PageTitle>Audyt dokumentacji</PageTitle>
<h1>Audyt dokumentacji</h1>
<p>Rejestr dostępu zawiera metadane operacji. Czas jest podany w UTC.</p>
@if (error is not null) { <p role="alert">@error</p> }
@if (page is not null)
{
    <div class="table-responsive" tabindex="0" role="region" aria-label="Tabela wyników"><table class="table"><thead><tr><th>Czas UTC</th><th>Użytkownik</th><th>Rola</th><th>Operacja</th><th>Zasób / ID</th><th>Pacjent ID</th></tr></thead><tbody>
    @foreach (var item in page.Items)
    {
        <tr><td>@item.OccurredAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td><td>@item.Actor</td><td>@item.ActorRole</td><td>@item.Action</td><td>@item.Resource / @item.ResourceId</td><td>@item.PatientId</td></tr>
    }
    </tbody></table></div>
    <Pagination Page="query.Page" TotalPages="page.TotalPages" TotalCount="page.TotalCount" Busy="@(!IsInteractive || loading)" PageChanged="LoadAsync" />
}
@code {
    private PageQueryDto query = new();
    private PagedResult<ClinicalAuditDto>? page;
    private bool loading;
    private string? error;
    protected override Task OnInitializedAsync() => LoadAsync(1);
    private async Task LoadAsync(int number)
    {
        loading = true; query.Page = number;
        try { var result = await Lists.AuditAsync(query); if (result.IsSuccess) page = result.Value; else error = result.Error; }
        finally { loading = false; }
    }
}
