@inherits MedicalBookingSystem.BlazorServer.Shared.InteractivePageBase
@page "/doctor/prescriptions"
@attribute [Authorize(Roles = Roles.Doctor)]
@using MedicalBookingSystem.SharedKernel.Dto.AppointmentsDto
@using MedicalBookingSystem.SharedKernel.Dto.NotesPrescriptionDto
@inject IAppointmentService AppointmentService
@inject IMedicalRecordService MedicalRecordService
@inject UserAccess Access

<h3>Recepty do odbytych wizyt</h3>
<fieldset disabled="@(!IsInteractive || saving)">
@if (error is not null) { <div class="alert alert-danger" role="alert">@error</div> }
@if (appointments is null) { <p>Ładowanie...</p> }
else if (appointments.Count == 0) { <p>Brak wizyt oczekujących na dokumentację.</p> }
else
{
    @foreach (var appointment in appointments)
    {
        <section class="border rounded p-3 mb-3" @key="appointment.Id">
            <p>@appointment.Date.ToString("dd.MM.yyyy HH:mm") — <b>Pacjent ID:</b> @appointment.PatientId</p>
            <label>Lek<input class="form-control mb-2" @bind="drafts[appointment.Id].Medication" maxlength="100" /></label>
            <label>Dawkowanie<input class="form-control mb-2" @bind="drafts[appointment.Id].Dosage" maxlength="50" /></label>
            <label>Instrukcje<textarea class="form-control mb-2" @bind="drafts[appointment.Id].Instructions"></textarea></label>
            <label>Ważność w dniach<input type="number" min="1" max="365" class="form-control mb-2" @bind="drafts[appointment.Id].ValidityDays" /></label>
            <div><button class="btn btn-primary" disabled="@saving" @onclick="() => SaveAsync(appointment.Id)">Zapisz receptę</button></div>
        </section>
    }
}

</fieldset>

@code {
    private List<AppointmentDto>? appointments;
    private readonly Dictionary<int, CreatePrescriptionDto> drafts = new();
    private int doctorId;
    private bool saving;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        doctorId = await Access.DoctorIdAsync();
        appointments = (await AppointmentService.GetCompletedAppointmentsByDoctorIdAsync(doctorId)).Where(a => !a.HasPrescription).ToList();
        foreach (var appointment in appointments)
            drafts[appointment.Id] = new CreatePrescriptionDto { AppointmentId = appointment.Id, ValidityDays = 7 };
    }

    private async Task SaveAsync(int id)
    {
        if (saving) return;
        saving = true;
        try
        {
            var result = await MedicalRecordService.CreatePrescriptionAsync(drafts[id], doctorId);
            error = result.Error;
            if (result.IsSuccess) { appointments?.RemoveAll(a => a.Id == id); drafts.Remove(id); }
        }
        finally { saving = false; }
    }
}
