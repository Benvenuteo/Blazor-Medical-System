@inherits MedicalBookingSystem.BlazorServer.Shared.InteractivePageBase
@page "/admin/doctors"
@attribute [Authorize(Roles = Roles.Admin)]
@using MedicalBookingSystem.BlazorServer.Service
@using MedicalBookingSystem.SharedKernel
@using MedicalBookingSystem.SharedKernel.Dto
@using MedicalBookingSystem.SharedKernel.Dto.DtoHelp
@inject IDoctorService DoctorService
@inject DoctorImageUploader Uploader

<PageTitle>Lista lekarzy</PageTitle>
<h3>Lista lekarzy</h3>
<fieldset disabled="@(!IsInteractive || loading || uploading)">
<EditForm Model="search" OnSubmit="NewSearchAsync" class="d-flex gap-2 mb-3">
    <label for="region">Region</label>
    <InputText id="region" class="form-control" @bind-Value="search.Region" />
    <button class="btn btn-primary" type="submit" disabled="@loading">Szukaj</button>
</EditForm>
@if (error is not null) { <div class="alert alert-danger" role="alert">@error</div> }
@if (success is not null) { <div class="alert alert-success" role="status">@success</div> }
@if (loading) { <p>Ładowanie lekarzy...</p> }
else if (page is not null)
{
    <table class="table align-middle">
        <thead><tr><th>Lekarz</th><th>Numer PWZ</th><th>Region</th><th>Ocena</th><th>Zdjęcie</th><th>Grafik</th></tr></thead>
        <tbody>
            @foreach (var doctor in page.Items)
            {
                <tr @key="doctor.Id">
                    <td>@doctor.FirstName @doctor.LastName</td><td>@doctor.LicenseNumber</td><td>@doctor.Region</td>
                    <td>@doctor.AverageRating.ToString("0.0") (@doctor.ReviewCount)</td>
                    <td>
                        <img src="@doctor.ImageUrl" alt="Zdjęcie: @doctor.FirstName @doctor.LastName" width="60" height="60" style="object-fit:cover;border-radius:50%" />
                        <label class="btn btn-sm btn-outline-primary doctor-photo-upload">
                            Zmień zdjęcie
                            <InputFile OnChange="e => OnImageSelected(e, doctor.Id)" accept="image/jpeg,image/png" disabled="@(uploading || !IsInteractive)" aria-label="@($"Zmień zdjęcie: {doctor.FirstName} {doctor.LastName}")" />
                        </label>
                    </td>
                    <td><a class="btn btn-outline-success" href="@($"admin/doctors/{doctor.Id}/schedule")">Dodaj grafik</a></td>
                </tr>
            }
        </tbody>
    </table>
    <nav aria-label="Strony lekarzy" class="d-flex align-items-center gap-3">
        <button class="btn btn-outline-primary" disabled="@(search.Page <= 1)" @onclick="() => LoadAsync(-1)">Poprzednia</button>
        <span>Strona @search.Page z @(page.TotalPages) · Wyniki: @(page.TotalCount)</span>
        <button class="btn btn-outline-primary" disabled="@(search.Page >= page.TotalPages)" @onclick="() => LoadAsync(1)">Następna</button>
    </nav>
}

</fieldset>

@code {
    private SearchDoctorsDto search = new();
    private PagedResult<DoctorDto>? page;
    private bool loading;
    private bool uploading;
    private string? error;
    private string? success;

    protected override Task OnInitializedAsync() => LoadAsync(0);
    private Task NewSearchAsync() { search.Page = 1; return LoadAsync(0); }
    private async Task LoadAsync(int delta)
    {
        if (loading) return;
        loading = true; search.Page += delta; error = null;
        try
        {
            var result = await DoctorService.SearchDoctorsAsync(search);
            if (result.IsSuccess) page = result.Value; else error = result.Error;
        }
        finally { loading = false; }
    }

    private async Task OnImageSelected(InputFileChangeEventArgs args, int doctorId)
    {
        if (uploading) return;
        uploading = true; error = null; success = null;
        try
        {
            using var stream = args.File.OpenReadStream(10 * 1024 * 1024);
            var result = await Uploader.ReplaceAsync(doctorId, stream, args.File.Name);
            if (result.IsFailure) { error = result.Error; return; }
            success = "Zdjęcie zaktualizowano.";
            await LoadAsync(0);
        }
        catch (IOException) { error = "Nie udało się zapisać zdjęcia. Sprawdź rozmiar pliku i spróbuj ponownie."; }
        finally { uploading = false; }
    }
}
