@page
@model MedicalBookingSystem.BlazorServer.Pages.Account.ChangePasswordModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html><html lang="pl"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Zmiana hasła</title><link rel="stylesheet" href="/css/bootstrap/bootstrap.min.css" /></head>
<body><main class="container py-5" style="max-width: 520px">
<h1>Zmiana hasła</h1>
<p>Hasło musi mieć 12–128 znaków, dużą literę i cyfrę. Zmiana wyloguje wszystkie sesje tego konta. Hasło tymczasowe trzeba zmienić przed wejściem do panelu.</p>
<form method="post">
<div asp-validation-summary="All" class="text-danger"></div>
<label asp-for="Input.CurrentPassword">Aktualne hasło</label><input asp-for="Input.CurrentPassword" type="password" autocomplete="current-password" class="form-control mb-3" />
<label asp-for="Input.NewPassword">Nowe hasło</label><input asp-for="Input.NewPassword" type="password" autocomplete="new-password" class="form-control mb-3" />
<label asp-for="Input.ConfirmNewPassword">Powtórz nowe hasło</label><input asp-for="Input.ConfirmNewPassword" type="password" autocomplete="new-password" class="form-control mb-3" />
@if (Model.Error is not null) { <p role="alert" class="text-danger">@Model.Error</p> }
<button type="submit" class="btn btn-primary">Zmień hasło</button>
</form><p class="mt-3"><a href="/Account/Logout">Wyloguj</a></p></main></body></html>
