@page
@model MedicalBookingSystem.BlazorServer.Pages.Account.LoginModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="pl"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Logowanie personelu</title><link rel="stylesheet" href="/css/bootstrap/bootstrap.min.css" /></head>
<body><main class="container py-5" style="max-width: 480px">
<h1>Logowanie personelu</h1>
<form method="post">
<div asp-validation-summary="All" class="text-danger"></div>
<label asp-for="Email">Email</label><input asp-for="Email" type="email" autocomplete="username" class="form-control mb-3" />
<label asp-for="Password">Hasło</label><input asp-for="Password" type="password" autocomplete="current-password" class="form-control mb-3" />
@if (Model.Error is not null) { <p class="text-danger" role="alert">@Model.Error</p> }
<button type="submit" class="btn btn-primary">Zaloguj się</button>
</form></main></body></html>
