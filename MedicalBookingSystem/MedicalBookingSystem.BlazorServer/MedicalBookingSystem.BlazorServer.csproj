<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <Configurations>Debug;Release;BezSerwera</Configurations>
    <!-- The SDK adds the package with blazor.server.js only when restore sees .razor files. The container
         build restores from project files alone (for layer caching), so the dependency is stated here. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MedicalBookingSystem.Application\MedicalBookingSystem.Application.csproj" />
    <ProjectReference Include="..\MedicalBookingSystem.Infrastructure\MedicalBookingSystem.Infrastructure.csproj" />
    <ProjectReference Include="..\MedicalBookingSystem.SharedKernel\MedicalBookingSystem.SharedKernel.csproj" />
    <ProjectReference Include="..\MedicalBookingSystem.UI.Shared\MedicalBookingSystem.UI.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MudBlazor" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="NLog.Web.AspNetCore" />
  </ItemGroup>
</Project>
