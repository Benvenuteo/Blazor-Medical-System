@inherits LayoutComponentBase
@inject IConfiguration Configuration

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<PageTitle>Management System</PageTitle>

<div class="page" aria-busy="@(!connected ? "true" : "false")">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        @if (Configuration.GetValue<bool>("Demo:Enabled"))
        {
            <div class="demo-banner" role="note">Wersja demonstracyjna · wszystkie dane są fikcyjne · konta demo są chronione przed zmianą</div>
        }
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private bool connected;
    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        connected = true;
        StateHasChanged();
    }
}
