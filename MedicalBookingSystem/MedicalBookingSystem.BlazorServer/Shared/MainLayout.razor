@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<PageTitle>Management System</PageTitle>

<div class="page" aria-busy="@(!connected ? "true" : "false")">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private bool connected;
    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        connected = true;
        StateHasChanged();
    }
}
