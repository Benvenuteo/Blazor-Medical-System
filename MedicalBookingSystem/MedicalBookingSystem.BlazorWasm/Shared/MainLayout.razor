@inherits LayoutComponentBase
@using MudBlazor

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Color="Color.Primary">
        <MudText Typo="Typo.h6">Medical Booking System</MudText>
    </MudAppBar>

    <MudDrawer Style="background: linear-gradient(180deg, #092447, #183f69); color: white;" Anchor="Anchor.Left" Open="true" ClipMode="DrawerClipMode.Always">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <div class="p-4">@Body</div>
    </MudMainContent>
</MudLayout>