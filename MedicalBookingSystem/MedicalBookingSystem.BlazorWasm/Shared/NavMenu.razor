@inject PatientAuthenticationStateProvider Authentication
@inject NavigationManager Navigation
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Rezerwacje medyczne</a>

    </div>
</div>

<div>
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="appointments">
                <span class="oi oi-plus" aria-hidden="true"></span> Moje wizyty
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="historyAppointments">
                <span class="oi oi-list-rich" aria-hidden="true"></span> Odbyte wizyty
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/doctors/search">
                <span class="oi oi-plus" aria-hidden="true"></span> Lekarze
            </NavLink>
        </div>
        <div class="nav-item px-3"><NavLink class="nav-link" href="/documents">Moje dokumenty</NavLink></div>
        <div class="nav-item px-3"><NavLink class="nav-link" href="/account/security">Bezpieczeństwo konta</NavLink></div>
        <div class="nav-item px-3">
            <button type="button" class="nav-link btn btn-link text-white" @onclick="LogoutAsync">
                <span class="oi oi-logout" aria-hidden="true"></span> Wyloguj
            </button>
        </div>
    </nav>
</div>

@code {
    private async Task LogoutAsync()
    {
        await Authentication.LogoutAsync();
        Navigation.NavigateTo("/", replace: true);
    }

}
