@page "/appointments/create"
@attribute [Authorize(Roles = Roles.Patient)]
@using MedicalBookingSystem.SharedKernel.Dto
@using MedicalBookingSystem.SharedKernel.Dto.AppointmentsDto
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>Zarezerwuj wizytę</h3>
<p>Wizyty trwają 30 minut. Wszystkie terminy podano w czasie placówki.</p>
@if (error is not null) { <div class="alert alert-danger" role="alert">@error</div> }
<label for="doctor">Lekarz</label>
<select id="doctor" disabled="@saving" class="form-select mb-3" value="@selectedDoctorId" @onchange="DoctorChanged">
    <option value="0">Wybierz lekarza</option>
    @foreach (var doctor in doctors) { <option value="@doctor.Id">@doctor.FirstName @doctor.LastName</option> }
</select>
@if (page is not null)
{
    <nav aria-label="Wybór lekarza" class="d-flex gap-2 mb-3">
        <button class="btn btn-outline-primary" disabled="@(saving || doctorPage <= 1)" @onclick="() => LoadDoctorsAsync(-1)">Poprzedni lekarze</button>
        <button class="btn btn-outline-primary" disabled="@(saving || doctorPage >= page.TotalPages)" @onclick="() => LoadDoctorsAsync(1)">Następni lekarze</button>
    </nav>
}
@if (loading) { <p>Ładowanie terminów...</p> }
else if (selectedDoctorId > 0)
{
    @if (slots.Count == 0) { <p>Brak dostępnych terminów.</p> }
    else
    {
        <label for="slot">Wolny termin</label>
        <select id="slot" disabled="@saving" class="form-select mb-3" @bind="selectedStart">
            <option value="">Wybierz termin</option>
            @foreach (var slot in slots)
            {
                <option value="@slot.StartTime.ToString("s")">@slot.StartTime.ToString("dd.MM.yyyy HH:mm") – @slot.EndTime.ToString("HH:mm")</option>
            }
        </select>
        <button class="btn btn-primary" disabled="@(saving || string.IsNullOrEmpty(selectedStart))" @onclick="BookAsync">Zarezerwuj</button>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "doctorId")] public int? DoctorId { get; set; }
    private PagedResult<DoctorDto>? page;
    private int doctorPage = 1;
    private List<DoctorDto> doctors = [];
    private List<AvailableSlotDto> slots = [];
    private int selectedDoctorId;
    private string selectedStart = string.Empty;
    private string? error;
    private bool loading;
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        if (DoctorId is > 0)
        {
            try
            {
                var doctor = await Http.GetFromJsonAsync<DoctorDetailsDto>($"api/doctors/{DoctorId}");
                if (doctor is not null) { doctors = [doctor]; selectedDoctorId = doctor.Id; await LoadSlotsAsync(); }
            }
            catch (HttpRequestException) { error = "Nie udało się pobrać lekarza."; }
        }
        else await LoadDoctorsAsync(0);
    }

    private async Task LoadDoctorsAsync(int delta)
    {
        doctorPage += delta;
        try
        {
            page = await Http.GetFromJsonAsync<PagedResult<DoctorDto>>($"api/doctors?Page={doctorPage}&PageSize=10");
            doctors = page?.Items.ToList() ?? [];
            selectedDoctorId = 0; selectedStart = string.Empty; slots = [];
        }
        catch (HttpRequestException) { error = "Nie udało się pobrać lekarzy."; }
    }

    private async Task DoctorChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out selectedDoctorId)) selectedDoctorId = 0;
        selectedStart = string.Empty;
        error = null;
        await LoadSlotsAsync();
    }

    private async Task LoadSlotsAsync()
    {
        var doctorId = selectedDoctorId;
        slots = [];
        loading = false;
        if (doctorId <= 0) return;
        loading = true;
        try
        {
            var available = await Http.GetFromJsonAsync<List<AvailableSlotDto>>($"api/doctors/{doctorId}/slots") ?? [];
            if (selectedDoctorId == doctorId) slots = available;
        }
        catch (HttpRequestException) { if (selectedDoctorId == doctorId) error = "Nie udało się pobrać terminów."; }
        finally { if (selectedDoctorId == doctorId) loading = false; }
    }

    private async Task BookAsync()
    {
        if (saving || !DateTime.TryParse(selectedStart, System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var start)) return;
        saving = true;
        try
        {
            using var response = await Http.PostAsJsonAsync("api/appointments", new CreateAppointmentDto
            {
                DoctorId = selectedDoctorId, Date = DateTime.SpecifyKind(start, DateTimeKind.Unspecified)
            });
            if (response.IsSuccessStatusCode) { Navigation.NavigateTo("/appointments"); return; }
            error = await ApiErrors.ReadAsync(response);
            if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                selectedStart = string.Empty;
                await LoadSlotsAsync();
            }
        }
        catch (HttpRequestException) { error = "Nie udało się zapisać wizyty. Spróbuj ponownie."; }
        finally { saving = false; }
    }
}
