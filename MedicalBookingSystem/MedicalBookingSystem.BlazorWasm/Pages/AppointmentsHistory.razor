@using MedicalBookingSystem.SharedKernel
@using MedicalBookingSystem.SharedKernel.Dto.AppointmentsDto
@page "/historyAppointments"
@attribute [Authorize(Roles = Roles.Patient)]
@inject HttpClient Http
@inject NavigationManager Navigation


<h3 class="mt-4">Moje odbyte wizyty</h3>

@if (isLoading)
{
    <p>Ładowanie wizyt...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (appointments.Count == 0)
{
    <div class="alert alert-info">Brak historii wizyt</div>
}
else
{
    <div class="table-responsive" tabindex="0" role="region" aria-label="Tabela wyników"><table class="table mt-3">
        <thead>
            <tr>
                <th>Data</th>
                <th>Godzina</th>
                <th>Lekarz</th>
                <th>Akcje</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var appointment in appointments)
            {
                <tr>
                    <td>@appointment.Date.ToShortDateString()</td>
                    <td>@appointment.Date.ToShortTimeString()</td>
                    <td>@appointment.DoctorName<ClinicInfo Name="@appointment.ClinicName" Address="@appointment.ClinicAddress" Latitude="@appointment.ClinicLatitude" Longitude="@appointment.ClinicLongitude" /></td>
                    <td>
                        <button class="btn btn-primary btn-sm" @onclick="() => ShowDetails(appointment.Id)">Szczegóły</button>
                        <button class="btn btn-success btn-sm ms-1" @onclick="() => StartReview(appointment)">Oceń lekarza</button>
                    </td>
                </tr>
            }
        </tbody>
    </table></div>


    @if (reviewSaved is not null)
    {
        <p class="alert alert-success mt-3" role="status">@reviewSaved</p>
    }

    @if (reviewedAppointment is not null)
    {
        <DoctorReviewForm DoctorId="reviewedAppointment.DoctorId" DoctorName="@reviewedAppointment.DoctorName"
                          OnSaved="ReviewSavedAsync" OnCancel="() => reviewedAppointment = null" />
    }

    @if (selectedAppointment != null)
    {
        <div class="mt-3 alert alert-info">
            <h5>Szczegóły wizyty</h5>
            <p><strong>Data:</strong> @selectedAppointment.Date.ToString("yyyy-MM-dd")</p>
            <p><strong>Lekarz:</strong> @selectedAppointment.Doctor?.FirstName @selectedAppointment.Doctor?.LastName</p>
            <p><strong>Pacjent:</strong> @selectedAppointment.Patient?.FirstName @selectedAppointment.Patient?.LastName</p>
            <p><strong>Notatka:</strong> @selectedAppointment.Note?.Content</p>
            <p><strong>Recepta:</strong> @selectedAppointment.Prescription?.Medication @selectedAppointment.Prescription?.Dosage @selectedAppointment.Prescription?.Instructions</p>
            <p><strong>Data ważności recepty:</strong> @(selectedAppointment.Prescription is { } prescription ? prescription.ExpiryDate.ToString("dd.MM.yyyy") : "—")</p>
        </div>
    }
}

@if (detailsLoading) { <p role="status">Ładowanie szczegółów wizyty...</p> }
@if (detailsError is not null) { <p class="alert alert-danger" role="alert">@detailsError</p> }

<Pagination Page="currentPage" TotalPages="@(page?.TotalPages ?? 0)" TotalCount="@(page?.TotalCount ?? 0)" Busy="isLoading" PageChanged="LoadPageAsync" />

@code {
    private PagedResult<AppointmentDto>? page;
    private int currentPage = 1;
    private async Task LoadPageAsync(int nextPage)
    {
        detailsRequest++; detailsLoading = false; detailsError = null;
        currentPage = nextPage; selectedAppointment = null; reviewedAppointment = null; reviewSaved = null; errorMessage = null; isLoading = true;
        await OnInitializedAsync();
    }

    private List<AppointmentDto> appointments = new();
    private bool isLoading = true;
    private string? errorMessage;
    private AppointmentDetailsDto? selectedAppointment;
    private int detailsRequest;
    private bool detailsLoading;
    private string? detailsError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<PagedResult<AppointmentDto>>($"api/appointments/history?page={currentPage}");

            page = response;
            appointments = response?.Items.ToList() ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = ApiErrors.Describe(ex, "Nie udało się wczytać wizyt");
        }
        finally
        {
            isLoading = false;
        }
    }

    private AppointmentDto? reviewedAppointment;
    private string? reviewSaved;

    private void StartReview(AppointmentDto appointment)
    {
        reviewSaved = null;
        reviewedAppointment = appointment;
    }

    private Task ReviewSavedAsync()
    {
        reviewSaved = $"Dziękujemy, opinia o lekarzu {reviewedAppointment?.DoctorName} została dodana.";
        reviewedAppointment = null;
        return Task.CompletedTask;
    }

    private async Task ShowDetails(int appointmentId)
    {
        var request = ++detailsRequest;
        detailsLoading = true; detailsError = null; selectedAppointment = null;
        try
        {
            using var response = await Http.GetAsync($"api/appointments/{appointmentId}");
            if (response.IsSuccessStatusCode)
            {
                var details = await response.Content.ReadFromJsonAsync<AppointmentDetailsDto>();
                if (request == detailsRequest) selectedAppointment = details;
            }
            else
            {
                var message = await ApiErrors.ReadAsync(response);
                if (request == detailsRequest) detailsError = message;
            }
        }
        catch (HttpRequestException)
        {
            if (request == detailsRequest) detailsError = "Nie udało się pobrać szczegółów wizyty. Spróbuj ponownie.";
        }
        finally { if (request == detailsRequest) detailsLoading = false; }
    }
}
