@page "/account/security"
@attribute [Authorize(Roles = Roles.Patient)]
@using MedicalBookingSystem.SharedKernel.Dto
@inject HttpClient Http
@inject PatientAuthenticationStateProvider Authentication
@inject NavigationManager Navigation

<PageTitle>Bezpieczeństwo konta</PageTitle>
<h1>Bezpieczeństwo konta</h1>
@if (isDemo)
{
    <p class="alert alert-info" role="status">To publiczne konto demonstracyjne — jego hasła, logowania i sesji nie można zmieniać. Pozostałe funkcje działają normalnie.</p>
}
@if (error is not null) { <p class="alert alert-danger" role="alert">@error</p> }
@if (message is not null) { <p class="alert alert-success" role="status">@message</p> }
<fieldset disabled="@(busy || isDemo)">
<h2 class="h4">Hasło</h2>
@if (status is { HasPassword: false })
{
    <p>To konto loguje się przez Google i nie ma hasła. Aby je ustawić, użyj <a href="/forgot-password">„Nie pamiętasz hasła?”</a> — link przyjdzie na Twój adres email.</p>
}
else
{
    <p>Zmiana hasła kończy wszystkie dotychczasowe sesje. Po zmianie zaloguj się ponownie.</p>
    <EditForm Model="password" OnSubmit="ChangeAsync">
        <label for="current-password">Aktualne hasło</label><InputText id="current-password" type="password" autocomplete="current-password" @bind-Value="password.CurrentPassword" class="form-control mb-3" />
        <label for="new-password">Nowe hasło</label><InputText id="new-password" type="password" autocomplete="new-password" @bind-Value="password.NewPassword" class="form-control mb-3" />
        <label for="confirm-password">Powtórz nowe hasło</label><InputText id="confirm-password" type="password" autocomplete="new-password" @bind-Value="password.ConfirmNewPassword" class="form-control mb-3" />
        <p>Hasło musi mieć 8–128 znaków i zawierać dużą literę oraz cyfrę.</p>
        <button type="submit" class="btn btn-primary">Zmień hasło</button>
    </EditForm>
}

@if (status is { GoogleEnabled: true })
{
    <hr /><h2 class="h4">Logowanie przez Google</h2>
    @if (status.GoogleLinked)
    {
        <p>Połączone konto Google: <strong>@status.GoogleEmail</strong>. Możesz logować się hasłem albo przez Google.</p>
        <button class="btn btn-outline-secondary" disabled="@(!status.HasPassword)" @onclick="UnlinkAsync">Odłącz konto Google</button>
        @if (!status.HasPassword) { <p class="small text-muted mt-2">Najpierw ustaw hasło, aby nie stracić dostępu do konta.</p> }
    }
    else
    {
        <p>Połącz konto Google, aby logować się jednym kliknięciem. Dla bezpieczeństwa potwierdź aktualne hasło, a potem wybierz konto Google.</p>
        <label for="link-password">Aktualne hasło</label>
        <InputText id="link-password" type="password" autocomplete="current-password" @bind-Value="linkPassword" class="form-control mb-3" style="max-width: 420px" />
        @if (!isDemo) { <GoogleSignInButton OnCredential="LinkAsync" /> }
    }
}

<hr /><h2 class="h4">Aktywne sesje</h2><p>Możesz zakończyć wszystkie logowania na tym koncie, również na innych urządzeniach.</p>
<label class="d-block mb-3"><InputCheckbox @bind-Value="confirmed" /> Potwierdzam wylogowanie wszystkich sesji</label>
<button class="btn btn-outline-danger" disabled="@(!confirmed)" @onclick="RevokeAsync">Wyloguj wszystkie sesje</button>
</fieldset>

@code {
    private UpdatePatientDto password = new();
    private ExternalLoginStatusDto? status;
    private string linkPassword = string.Empty;
    private bool busy, confirmed, isDemo;
    private string? error, message;

    protected override async Task OnInitializedAsync()
    {
        isDemo = AccountClaims.IsDemo((await Authentication.GetAuthenticationStateAsync()).User);
        await LoadStatusAsync();
    }

    private async Task LoadStatusAsync()
    {
        try { status = await Http.GetFromJsonAsync<ExternalLoginStatusDto>("api/auth/google/status"); }
        catch (Exception exception) when (exception is HttpRequestException or System.Text.Json.JsonException) { status = null; }
    }

    private Task ChangeAsync() => RunAsync(async () =>
    {
        if (string.IsNullOrWhiteSpace(password.NewPassword)) { error = "Podaj nowe hasło."; return; }
        using var response = await Http.PutAsJsonAsync("api/patients/profile", password);
        if (response.IsSuccessStatusCode) await FinishAsync(); else error = await ApiErrors.ReadAsync(response);
    });

    private Task LinkAsync(GoogleSignInDto credential) => RunAsync(async () =>
    {
        using var response = await Http.PostAsJsonAsync("api/auth/google/link",
            new LinkGoogleDto { IdToken = credential.IdToken, Nonce = credential.Nonce, CurrentPassword = linkPassword });
        if (!response.IsSuccessStatusCode) { error = await ApiErrors.ReadAsync(response); return; }
        linkPassword = string.Empty;
        message = "Konto Google zostało połączone.";
        await LoadStatusAsync();
    });

    private Task UnlinkAsync() => RunAsync(async () =>
    {
        using var response = await Http.DeleteAsync("api/auth/google/link");
        if (!response.IsSuccessStatusCode) { error = await ApiErrors.ReadAsync(response); return; }
        message = "Konto Google zostało odłączone.";
        await LoadStatusAsync();
    });

    private Task RevokeAsync() => RunAsync(async () =>
    {
        if (!confirmed) return;
        using var response = await Http.PostAsync("api/auth/logout-all", null);
        if (response.IsSuccessStatusCode) await FinishAsync(); else error = await ApiErrors.ReadAsync(response);
    });

    private async Task FinishAsync()
    {
        password = new();
        await Authentication.LogoutAsync();
        Navigation.NavigateTo("/?sessionEnded=true", replace: true);
    }

    private async Task RunAsync(Func<Task> operation)
    {
        if (busy) return;
        busy = true; error = null; message = null;
        try { await operation(); }
        catch (HttpRequestException) { error = "Nie udało się połączyć z serwerem."; }
        finally { busy = false; StateHasChanged(); }
    }
}
