@page "/forgot-password"
@layout EmptyLayout
@using MedicalBookingSystem.SharedKernel.Dto
@inject HttpClient Http

<PageTitle>Nie pamiętasz hasła?</PageTitle>
<h1 class="h3">Nie pamiętasz hasła?</h1>

@if (sent)
{
    <p class="alert alert-success" role="status">
        Jeśli konto o adresie <strong>@model.Email</strong> istnieje, wysłaliśmy na nie link do ustawienia nowego hasła.
        Link jest ważny przez 30 minut.
    </p>
    <a href="/">Wróć do logowania</a>
}
else
{
    <p>Podaj adres email konta pacjenta. Wyślemy jednorazowy link do ustawienia nowego hasła.</p>
    @if (error is not null) { <p class="alert alert-danger" role="alert">@error</p> }
    <fieldset disabled="@busy">
        <EditForm Model="model" OnSubmit="SubmitAsync">
            <label for="email">Email</label>
            <InputText id="email" type="email" autocomplete="username" @bind-Value="model.Email" class="form-control mb-3" />
            <button type="submit" class="btn btn-primary">Wyślij link</button>
            <a class="btn btn-link" href="/">Anuluj</a>
        </EditForm>
    </fieldset>
}

@code {
    private readonly ForgotPasswordDto model = new();
    private bool busy, sent;
    private string? error;

    private async Task SubmitAsync()
    {
        if (busy) return;
        busy = true; error = null;
        try
        {
            using var response = await Http.PostAsJsonAsync("api/auth/forgot-password", model);
            if (response.IsSuccessStatusCode) sent = true;
            else error = await ApiErrors.ReadAsync(response);
        }
        catch (Exception exception) { error = ApiErrors.Describe(exception, "Nie udało się wysłać prośby"); }
        finally { busy = false; }
    }
}
