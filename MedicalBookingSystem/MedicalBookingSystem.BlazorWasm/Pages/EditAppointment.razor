@page "/appointments/edit/{appointmentId:int}"
@attribute [Authorize(Roles = Roles.Patient)]
@using MedicalBookingSystem.SharedKernel.Dto.AppointmentsDto
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>Zmień termin wizyty</h3>
@if (error is not null) { <div class="alert alert-danger" role="alert">@error</div> }
@if (loading) { <p>Ładowanie danych wizyty...</p> }
else if (details is not null)
{
    <p>Obecny termin: <strong>@details.Date.ToString("dd.MM.yyyy HH:mm")</strong>, @details.DoctorName</p>
    <p>Terminy podano w czasie placówki. Zmiana wymaga co najmniej 24 godzin do obecnej wizyty.</p>
    <label for="new-slot">Nowy termin</label>
    <select id="new-slot" disabled="@saving" class="form-select mb-3" @bind="selectedStart">
        <option value="">Wybierz termin</option>
        @foreach (var slot in slots)
        {
            <option value="@slot.StartTime.ToString("s")">@slot.StartTime.ToString("dd.MM.yyyy HH:mm") – @slot.EndTime.ToString("HH:mm")</option>
        }
    </select>
    <button class="btn btn-primary" disabled="@(saving || string.IsNullOrEmpty(selectedStart))" @onclick="SaveAsync">Zapisz termin</button>
}

@code {
    [Parameter] public int appointmentId { get; set; }
    private AppointmentDetailsDto? details;
    private List<AvailableSlotDto> slots = [];
    private string selectedStart = string.Empty;
    private string? error;
    private bool loading = true;
    private bool saving;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        error = null;
        details = null;
        slots = [];
        try
        {
            details = await Http.GetFromJsonAsync<AppointmentDetailsDto>($"api/appointments/{appointmentId}");
            if (details is null) { error = "Nie znaleziono wizyty."; return; }
            await LoadSlotsAsync();
            selectedStart = slots.Any(s => s.StartTime == details.Date) ? details.Date.ToString("s") : string.Empty;
        }
        catch (HttpRequestException) { error = "Nie udało się pobrać wizyty lub nie masz do niej dostępu."; }
        finally { loading = false; }
    }

    private async Task LoadSlotsAsync() => slots = await Http.GetFromJsonAsync<List<AvailableSlotDto>>(
        $"api/doctors/{details!.DoctorId}/slots?excludedAppointmentId={appointmentId}") ?? [];

    private async Task SaveAsync()
    {
        if (saving || !DateTime.TryParse(selectedStart, System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var start)) return;
        saving = true;
        try
        {
            using var response = await Http.PutAsJsonAsync($"api/appointments/{appointmentId}", new UpdateAppointmentDto
                { NewDate = DateTime.SpecifyKind(start, DateTimeKind.Unspecified) });
            if (response.IsSuccessStatusCode) { Navigation.NavigateTo("/appointments"); return; }
            error = await ApiErrors.ReadAsync(response);
            if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                selectedStart = string.Empty;
                details = await Http.GetFromJsonAsync<AppointmentDetailsDto>($"api/appointments/{appointmentId}");
                if (details is not null) await LoadSlotsAsync();
            }
        }
        catch (HttpRequestException) { error = "Nie udało się zapisać terminu."; }
        finally { saving = false; }
    }
}
