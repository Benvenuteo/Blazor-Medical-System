@using MedicalBookingSystem.SharedKernel.Dto
@page "/"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject PatientAuthenticationStateProvider Authentication
@inject IConfiguration Configuration


<h3>Logowanie</h3>
@if (SessionEnded)
{
    <p role="status">Sesje zakończone. Zaloguj się ponownie.</p>
}

@if (demoEnabled)
{
    <aside class="alert alert-info d-flex flex-wrap align-items-center gap-2" aria-label="Konto demonstracyjne">
        <span><strong>Wersja demonstracyjna</strong> — zaloguj się kontem <strong>@demoEmail</strong> (dane są fikcyjne).</span>
        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="FillDemo">Wypełnij dane demo</button>
    </aside>
}

<EditForm Model="loginDto" OnSubmit="HandleLogin">
<div class="mb-3">
    <label for="email">Email</label>
    <input id="email" type="email" autocomplete="username" @bind="loginDto.Email" class="form-control" />
</div>
<div class="mb-3">
    <label for="password">Hasło</label>
    <input id="password" autocomplete="current-password" type="password" @bind="loginDto.Password" class="form-control" />
</div>
<button type="submit" disabled="@saving" class="btn btn-primary">Zaloguj się</button>
<button type="button" class="btn btn-link" @onclick="Register">Zarejestruj się</button>
<a class="btn btn-link" href="/forgot-password">Nie pamiętasz hasła?</a>

</EditForm>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger mt-2">@error</div>
}

@if (!string.IsNullOrWhiteSpace(Configuration["Google:ClientId"]))
{
    <div class="auth-divider" role="separator"><span>lub</span></div>
    <GoogleSignInButton />
}

@code {
    [SupplyParameterFromQuery(Name = "sessionEnded")] public bool SessionEnded { get; set; }
    private LoginDto loginDto = new();
    private string? error;
    private bool saving;
    private bool demoEnabled;
    private string? demoEmail, demoPassword;

    protected override void OnInitialized()
    {
        demoEnabled = Configuration.GetValue<bool>("Demo:Enabled");
        demoEmail = Configuration["Demo:PatientEmail"];
        demoPassword = Configuration["Demo:PatientPassword"];
        demoEnabled &= !string.IsNullOrEmpty(demoEmail) && !string.IsNullOrEmpty(demoPassword);
    }

    private void FillDemo()
    {
        loginDto.Email = demoEmail!;
        loginDto.Password = demoPassword!;
    }

    private void Register(){
        Navigation.NavigateTo($"/register");
    }

    private async Task HandleLogin()
    {
        if (saving) return;
        saving = true;
        error = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/login", loginDto);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<AuthenticationResponseDto>();
                if (string.IsNullOrWhiteSpace(result?.Token))
                {
                    error = "Serwer zwrócił nieprawidłową odpowiedź logowania.";
                    return;
                }
                await Authentication.SignInAsync(result.Token);
                Navigation.NavigateTo("/dashboard");
            }
            else
            {
                error = await ApiErrors.ReadAsync(response);
            }
        }
        catch (HttpRequestException) { error = "Nie udało się połączyć z serwerem."; }
        finally { saving = false; }
    }

}
