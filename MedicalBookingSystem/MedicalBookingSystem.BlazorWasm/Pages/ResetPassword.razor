@page "/reset-password"
@layout EmptyLayout
@using MedicalBookingSystem.SharedKernel.Dto
@inject HttpClient Http

<PageTitle>Ustaw nowe hasło</PageTitle>
<h1 class="h3">Ustaw nowe hasło</h1>

@if (done)
{
    <p class="alert alert-success" role="status">Hasło zostało zmienione, a wcześniejsze sesje zakończone. Możesz się zalogować.</p>
    <a class="btn btn-primary" href="/">Przejdź do logowania</a>
}
else if (string.IsNullOrEmpty(Token))
{
    <p class="alert alert-warning" role="alert">Link jest niekompletny. Otwórz go ponownie z wiadomości email albo <a href="/forgot-password">poproś o nowy</a>.</p>
}
else
{
    @if (error is not null) { <p class="alert alert-danger" role="alert">@error <a href="/forgot-password">Poproś o nowy link</a>.</p> }
    <fieldset disabled="@busy">
        <EditForm Model="model" OnSubmit="SubmitAsync">
            <label for="new-password">Nowe hasło</label>
            <InputText id="new-password" type="password" autocomplete="new-password" @bind-Value="model.NewPassword" class="form-control mb-3" />
            <label for="confirm-password">Powtórz nowe hasło</label>
            <InputText id="confirm-password" type="password" autocomplete="new-password" @bind-Value="model.ConfirmNewPassword" class="form-control mb-3" />
            <p class="text-muted">Hasło musi mieć 8–128 znaków i zawierać dużą literę oraz cyfrę.</p>
            <button type="submit" class="btn btn-primary">Zapisz hasło</button>
        </EditForm>
    </fieldset>
}

@code {
    [SupplyParameterFromQuery(Name = "token")] public string? Token { get; set; }
    private readonly ResetPasswordDto model = new();
    private bool busy, done;
    private string? error;

    private async Task SubmitAsync()
    {
        if (busy) return;
        busy = true; error = null;
        try
        {
            model.Token = Token ?? string.Empty;
            using var response = await Http.PostAsJsonAsync("api/auth/reset-password", model);
            if (response.IsSuccessStatusCode) done = true;
            else error = await ApiErrors.ReadAsync(response);
        }
        catch (Exception exception) { error = ApiErrors.Describe(exception, "Nie udało się zmienić hasła"); }
        finally { busy = false; }
    }
}
