@using MedicalBookingSystem.SharedKernel.Dto
@using MedicalBookingSystem.SharedKernel.Dto.DtoHelp
@using MedicalBookingSystem.SharedKernel.Dto.ReviewsDto
@page "/doctors/search"
@attribute [Authorize(Roles = Roles.Patient)]
@inject HttpClient Http
@inject IJSRuntime JS
@implements IAsyncDisposable

<h3>Wyszukiwanie lekarzy</h3>

<EditForm Model="@searchDto" OnValidSubmit="NewSearch">
    <div class="mb-3">
        <label for="specialization">Specjalizacja</label>
        <InputSelect id="specialization" aria-describedby="selected-specialization" class="form-select" @bind-Value="searchDto.SpecializationId">
            <option value="">-- wybierz --</option>
            @foreach (var spec in specializations)
            {
                <option value="@spec.Id">@spec.Name</option>
            }
        </InputSelect>
        <div id="selected-specialization" class="form-text selected-value">@(specializations.FirstOrDefault(s => s.Id == searchDto.SpecializationId)?.Name)</div>
    </div>

    <fieldset class="mb-3">
        <legend class="form-label fs-6 mb-1">Lokalizacja</legend>
        <div class="d-flex flex-wrap gap-2">
            <input id="address" class="form-control" style="flex: 1 1 14rem" placeholder="Adres lub miejscowość, np. Kraków, Rynek Główny"
                   aria-label="Adres lub miejscowość" @bind="address" disabled="@locating" />
            <button type="button" class="btn btn-outline-primary" disabled="@locating" @onclick="FindAddressAsync">Ustaw adres</button>
            <button type="button" class="btn btn-outline-primary" disabled="@locating" @onclick="UseMyLocationAsync">Użyj mojej lokalizacji</button>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center mt-2">
            <label for="radius" class="mb-0">Promień</label>
            <select id="radius" class="form-select w-auto" @bind="radiusKm">
                <option value="10">10 km</option>
                <option value="30">30 km</option>
                <option value="50">50 km</option>
                <option value="100">100 km</option>
            </select>
            @if (centre is not null)
            {
                <span class="badge text-bg-light text-wrap text-start" role="status">Szukam w promieniu @radiusKm km od: @centreLabel</span>
                <button type="button" class="btn btn-sm btn-link" @onclick="ClearLocation">Wyczyść lokalizację</button>
            }
        </div>
        @if (locating) { <p role="status" class="small mt-2 mb-0">Ustalanie lokalizacji...</p> }
        @if (locationError is not null) { <p class="alert alert-warning mt-2 mb-0" role="alert">@locationError</p> }
        <p class="form-text mb-0">Lokalizacja służy tylko do tego wyszukiwania; wysyłamy ją z dokładnością do ok. 1 km i nie zapisujemy.</p>
    </fieldset>

    <div class="mb-3">
        <label for="region">Region</label>
        <InputText id="region" class="form-control" @bind-Value="searchDto.Region" />
    </div>

    <div class="mb-3">
        <label for="date">Data dostępności</label>
        <InputDate id="date" class="form-control" @bind-Value="searchDto.Date" />
    </div>

    <div class="mb-3">
        <label for="sort">Sortuj według</label>
        <InputSelect id="sort" class="form-select" @bind-Value="searchDto.SortBy">
            <option value="">-- wybierz --</option>
            <option value="rating">Ocena</option>
            <option value="availability">Najbliższy termin</option>
            <option value="distance" disabled="@(centre is null)">Odległość</option>
        </InputSelect>
    </div>

    <button class="btn btn-primary" type="submit">Szukaj</button>
</EditForm>

@if (isLoading)
{
    <p>Ładowanie...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (doctors != null && doctors.Any())
{
    <div class="btn-group mt-3" role="group" aria-label="Widok wyników">
        <button type="button" class="btn @(showMap ? "btn-outline-primary" : "btn-primary")" aria-pressed="@(showMap ? "false" : "true")" @onclick="() => SetView(false)">Lista</button>
        <button type="button" class="btn @(showMap ? "btn-primary" : "btn-outline-primary")" aria-pressed="@(showMap ? "true" : "false")" @onclick="() => SetView(true)">Mapa</button>
    </div>
    @if (showMap)
    {
        <div @ref="mapHost" class="doctor-map mt-3" role="region" aria-label="Mapa placówek z wynikami wyszukiwania"></div>
        <p class="form-text">Na mapie są placówki lekarzy z bieżącej strony wyników. Kliknij pinezkę, aby zobaczyć lekarzy i zarezerwować wizytę.</p>
    }
    <div class="table-responsive @(showMap ? "d-none" : "")" tabindex="0" role="region" aria-label="Tabela wyników"><table class="table table-bordered mt-3">
        <thead>
            <tr>
                <th>Zdjęcie</th>
                <th>Imię</th>
                <th>Nazwisko</th>
                <th>Placówka</th>
                <th>Ocena</th>
                <th>Liczba ocen</th>
                <th>Najbliższy termin</th>
                <th>Akcje</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var doctor in doctors)
            {
                <tr>
                    <td>
                        <img src="@doctor.ImageUrl" alt="Zdjęcie lekarza" style="width: 64px; height: 64px; object-fit: cover; border-radius: 50%;" />
                    </td>
                    <td>@doctor.FirstName</td>
                    <td>@doctor.LastName</td>
                    <td>
                        @if (doctor.ClinicName is not null)
                        {
                            <span>@doctor.ClinicName</span><br />
                            <span class="small text-muted">@doctor.ClinicAddress</span>
                            @if (doctor.DistanceKm is double km) { <br /><span class="badge text-bg-info">@FormatDistance(km)</span> }
                        }
                        else { <span>@doctor.Region</span> }
                    </td>
                    <td>
                        @if (doctor.ReviewCount == 0)
                        {
                            <span class="text-muted">Brak ocen</span>
                        }
                        else
                        {
                            var fullStars = (int)Math.Round(doctor.AverageRating, MidpointRounding.AwayFromZero);
                            <span aria-hidden="true">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <span style="color:@(i <= fullStars ? "goldenrod" : "lightgray")">★</span>
                                }
                            </span>
                            <span class="ms-1">@FormatRating(doctor.AverageRating)</span>
                            <span class="visually-hidden"> na 5</span>
                        }
                    </td>
                    <td>@doctor.ReviewCount</td>
                    <td>@(doctor.NextAvailableSlot?.ToString("dd.MM.yyyy HH:mm") ?? "Brak wolnych terminów")</td>
                    <td>
                        <div class="btn-group">
                            <a class="btn btn-sm btn-primary" href="@($"appointments/create?doctorId={doctor.Id}")">Zarezerwuj wizytę</a>
                            <button class="btn btn-sm btn-info" @onclick="() => ToggleReviews(doctor.Id)">
                                @((expandedDoctorIds.Contains(doctor.Id)) ? "Ukryj opinie" : "Pokaż opinie")
                            </button>
                        </div>
                    </td>
                </tr>

                @if (expandedDoctorIds.Contains(doctor.Id))
                {
                    <tr>
                        <td colspan="8">
                            @if (loadingReviews.Contains(doctor.Id))
                            {
                                <p>Ładowanie opinii...</p>
                            }
                            else if (reviewsByDoctor.TryGetValue(doctor.Id, out var reviewList))
                            {
                                @if (reviewList is not null && reviewList.Items.Any())
                                {
                                    <ul class="list-group">
                                        @foreach (var review in reviewList.Items)
                                        {
                                            <li class="list-group-item">
                                                <strong>@review.Rating ★</strong><br />
                                                @review.Comment
                                            </li>
                                        }
                                    </ul>
                                    <Pagination Page="reviewList.Page" TotalPages="reviewList.TotalPages" TotalCount="reviewList.TotalCount" Busy="@(loadingReviews.Contains(doctor.Id))" PageChanged="p => LoadReviewPageAsync(doctor.Id, p)" Label="Strony opinii" />
                                }
                                else if (reviewList is null)
                                {
                                    <p class="text-danger">Nie udało się pobrać opinii. Spróbuj ponownie.</p>
                                }
                                else
                                {
                                    <p>Brak opinii dla tego lekarza.</p>
                                }
                            }
                            else
                            {
                                <p class="text-danger">Błąd podczas ładowania opinii.</p>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table></div>
    <nav aria-label="Strony lekarzy" class="d-flex align-items-center gap-3">
        <button class="btn btn-outline-primary" disabled="@(isLoading || searchDto.Page <= 1)" @onclick="() => ChangePage(-1)">Poprzednia</button>
        <span>Strona @searchDto.Page z @(page?.TotalPages ?? 0) · Wyniki: @(page?.TotalCount ?? 0)</span>
        <button class="btn btn-outline-primary" disabled="@(isLoading || searchDto.Page >= (page?.TotalPages ?? 0))" @onclick="() => ChangePage(1)">Następna</button>
    </nav>
}
else if (doctors != null)
{
    <div class="alert alert-info mt-3">Brak dostępnych lekarzy dla wybranych kryteriów.</div>
}

@code {
    private List<DoctorDto>? doctors;
    private List<SpecializationDto> specializations = new();
    private SearchDoctorsDto searchDto = new();
    private PagedResult<DoctorDto>? page;
    private bool isLoading = false;
    private string? errorMessage;
    private int searchRequest;

    // Location search: centre from an address (geocoded by the API) or from the browser, rounded to ~1 km.
    private sealed record Centre(double Latitude, double Longitude);
    private Centre? centre;
    private string? centreLabel, address, locationError;
    private int radiusKm = 30;
    private bool locating, showMap, mapDirty, mapRendered;
    private ElementReference mapHost;

    private static string FormatDistance(double km) =>
        km.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture).Replace('.', ',') + " km";
    private static string Invariant(double value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    private static Centre Rounded(double latitude, double longitude) => new(Math.Round(latitude, 2), Math.Round(longitude, 2));

    private async Task FindAddressAsync()
    {
        if (string.IsNullOrWhiteSpace(address)) { locationError = "Wpisz adres lub miejscowość."; return; }
        locating = true; locationError = null;
        try
        {
            using var response = await Http.GetAsync($"api/locations/geocode?q={Uri.EscapeDataString(address.Trim())}");
            if (!response.IsSuccessStatusCode) { locationError = await ApiErrors.ReadAsync(response); return; }
            var point = await response.Content.ReadFromJsonAsync<GeoPointDto>();
            centre = Rounded(point!.Latitude, point.Longitude);
            centreLabel = point.DisplayName;
            searchDto.SortBy = "distance";
        }
        catch (Exception exception) { locationError = ApiErrors.Describe(exception, "Nie udało się znaleźć adresu"); }
        finally { locating = false; }
    }

    private async Task UseMyLocationAsync()
    {
        locating = true; locationError = null;
        try
        {
            var position = await JS.InvokeAsync<Centre>("medicalMap.locate");
            centre = Rounded(position.Latitude, position.Longitude);
            centreLabel = "Twoja lokalizacja";
            searchDto.SortBy = "distance";
        }
        catch (JSException exception)
        {
            locationError = exception.Message.Contains("denied")
                ? "Przeglądarka nie udostępniła lokalizacji. Wpisz adres albo zezwól na dostęp do lokalizacji."
                : "Nie udało się ustalić lokalizacji. Wpisz adres lub miejscowość.";
        }
        finally { locating = false; }
    }

    private void ClearLocation()
    {
        centre = null; centreLabel = null; locationError = null;
        if (searchDto.SortBy == "distance") searchDto.SortBy = null;
    }

    private void SetView(bool map)
    {
        if (!map) mapRendered = false; // the map element leaves the page with the view
        showMap = map;
        mapDirty = map;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!mapDirty || !showMap || doctors is null) return;
        mapDirty = false;
        var clinics = doctors.Where(d => d.ClinicLatitude.HasValue && d.ClinicLongitude.HasValue)
            .GroupBy(d => d.ClinicId)
            .Select(g => new
            {
                name = g.First().ClinicName, address = g.First().ClinicAddress,
                latitude = g.First().ClinicLatitude, longitude = g.First().ClinicLongitude, distanceKm = g.First().DistanceKm,
                doctors = g.Select(d => new
                {
                    name = $"{d.FirstName} {d.LastName}",
                    nextSlot = d.NextAvailableSlot?.ToString("dd.MM.yyyy HH:mm"),
                    bookUrl = $"/appointments/create?doctorId={d.Id}"
                }).ToList()
            }).ToList();
        object? searchCentre = centre is null ? null : new { latitude = centre.Latitude, longitude = centre.Longitude, radiusKm };
        try { await JS.InvokeVoidAsync("medicalMap.showDoctors", mapHost, searchCentre, clinics); mapRendered = true; }
        catch (JSException) { locationError = "Nie udało się wczytać mapy. Wyniki są dostępne w widoku listy."; StateHasChanged(); }
    }

    public async ValueTask DisposeAsync()
    {
        if (!mapRendered) return;
        try { await JS.InvokeVoidAsync("medicalMap.dispose", mapHost); }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or InvalidOperationException) { }
    }

    // Polish decimal comma without depending on culture data being loaded in WebAssembly.
    private static string FormatRating(decimal rating) =>
        rating.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture).Replace('.', ',');

    private HashSet<int> expandedDoctorIds = new();
    private HashSet<int> loadingReviews = new();
    private Dictionary<int, PagedResult<ReviewDto>?> reviewsByDoctor = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            specializations = await Http.GetFromJsonAsync<List<SpecializationDto>>("api/doctors/specializations") ?? [];
        }
        catch (Exception ex)
        {
            errorMessage = ApiErrors.Describe(ex, "Nie udało się wczytać specjalizacji");
        }
    }

    private async Task NewSearch() { searchDto.Page = 1; await SearchDoctors(); }

    private async Task ChangePage(int delta) { searchDto.Page += delta; await SearchDoctors(); }

    private async Task SearchDoctors()
    {
        var request = ++searchRequest;
        isLoading = true;
        errorMessage = null;
        doctors = null;

        try
        {
            var queryParams = new List<string> { $"Page={searchDto.Page}", $"PageSize={searchDto.PageSize}" };

            if (searchDto.SpecializationId.HasValue)
                queryParams.Add($"SpecializationId={searchDto.SpecializationId.Value}");

            if (!string.IsNullOrWhiteSpace(searchDto.Region))
                queryParams.Add($"Region={Uri.EscapeDataString(searchDto.Region)}");

            if (searchDto.Date.HasValue)
                queryParams.Add($"Date={searchDto.Date.Value:yyyy-MM-dd}");

            if (!string.IsNullOrWhiteSpace(searchDto.SortBy))
                queryParams.Add($"SortBy={Uri.EscapeDataString(searchDto.SortBy)}");

            if (centre is not null)
                queryParams.Add($"Latitude={Invariant(centre.Latitude)}&Longitude={Invariant(centre.Longitude)}&RadiusKm={radiusKm}");

            var queryString = string.Join("&", queryParams);
            var result = await Http.GetFromJsonAsync<PagedResult<DoctorDto>>($"api/doctors?{queryString}");
            if (request != searchRequest) return;
            page = result;
            doctors = page?.Items.ToList() ?? [];
            mapDirty = showMap;
        }
        catch (Exception ex)
        {
            if (request == searchRequest) errorMessage = ApiErrors.Describe(ex, "Nie udało się pobrać lekarzy");
        }
        finally
        {
            if (request == searchRequest) isLoading = false;
        }
    }

    private async Task ToggleReviews(int doctorId)
    {
        if (expandedDoctorIds.Contains(doctorId))
        {
            expandedDoctorIds.Remove(doctorId);
        }
        else
        {
            expandedDoctorIds.Add(doctorId);

            if (!reviewsByDoctor.TryGetValue(doctorId, out var cached) || cached is null)
            {
                await LoadReviewPageAsync(doctorId, 1);
            }
        }
    }

    private async Task LoadReviewPageAsync(int doctorId, int pageNumber)
    {
        loadingReviews.Add(doctorId);
        try { reviewsByDoctor[doctorId] = await Http.GetFromJsonAsync<PagedResult<ReviewDto>>($"api/reviews/doctor/{doctorId}?page={pageNumber}"); }
        catch (HttpRequestException) { reviewsByDoctor[doctorId] = null; }
        finally { loadingReviews.Remove(doctorId); }
    }

}
