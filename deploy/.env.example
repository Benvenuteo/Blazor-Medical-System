# Copy to deploy/.env (never commit it) and fill in every value.
# Host names must resolve to the server's public IP; Caddy requests certificates for them.
PATIENT_HOST=medical-demo.duckdns.org
API_HOST=medical-api.duckdns.org
STAFF_HOST=medical-staff.duckdns.org
ACME_EMAIL=you@example.com

# At least 32 random bytes, e.g.: openssl rand -base64 48
JWT_SECRET_KEY=

# Created by deploy/scripts/create-secrets.sh together with deploy/secrets/dataprotection.pfx
DATAPROTECTION_CERT_PASSWORD=

# Public, fictional demo accounts (the same as in README). Set DEMO_DATA=false for a deployment without them.
DEMO_DATA=true
SEED_PATIENT_PASSWORD=DemoPatient2026!
SEED_STAFF_PASSWORD=DemoStaff2026!

# Google sign-in for patients: OAuth client ID (type "Web application"); empty hides the button.
GOOGLE_CLIENT_ID=

# Email: Pickup keeps messages as .eml files in the mail volume; Smtp sends them (e.g. a free transactional SMTP plan).
EMAIL_MODE=Pickup
EMAIL_FROM=Medical Booking System <no-reply@example.test>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Host directory for backups made by the maintenance tool (owned by UID 1654, see docs/DEPLOYMENT.md).
BACKUP_DIR=./backups

# Images: local builds by default; the deployment workflow sets the registry and tag.
IMAGE_REGISTRY=medical-booking
IMAGE_TAG=local
