# Include from the Nginx http context, for example conf.d/medical.conf.
# Replace host names, certificate paths and publish directories before use.
# Run API/staff Kestrel only on loopback. Trust this proxy's IP explicitly in both hosts.
map $http_upgrade $connection_upgrade { default upgrade; '' close; }

server {
    listen 80;
    server_name patient.example.test api.example.test staff.example.test;
    return 308 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name patient.example.test;
    ssl_certificate /etc/medical/tls/fullchain.pem;
    ssl_certificate_key /etc/medical/tls/private.key;
    root /srv/medical/patient/wwwroot;
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.example.test; img-src 'self' data: https:; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    location / { try_files $uri $uri/ /index.html; }
    location /_framework/ { try_files $uri =404; }
}
server {
    listen 443 ssl;
    server_name api.example.test;
    ssl_certificate /etc/medical/tls/fullchain.pem;
    ssl_certificate_key /etc/medical/tls/private.key;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location / {
        proxy_pass http://127.0.0.1:5031;
        proxy_set_header Host $host;
        # Replace incoming client-supplied forwarded values instead of extending them.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
server {
    listen 443 ssl;
    server_name staff.example.test;
    ssl_certificate /etc/medical/tls/fullchain.pem;
    ssl_certificate_key /etc/medical/tls/private.key;
    client_max_body_size 11m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location / {
        proxy_pass http://127.0.0.1:5187;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 120s;
    }
}
